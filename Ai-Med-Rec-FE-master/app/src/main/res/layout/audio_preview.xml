<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5">

    <!-- Title for the table -->
    <TextView
        android:id="@+id/tableTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:gravity="top|center_horizontal"
        android:text="Medication List"
        android:textColor="#000000"
        android:textSize="34sp"
        android:textStyle="bold" />

    <!-- Audio Preview Section -->
    <LinearLayout
        android:id="@+id/audioPreviewContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp"
        android:gravity="center_vertical"
        android:visibility="visible">

        <!-- Play/Pause Button -->
        <Button
            android:id="@+id/playPauseButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Play" />

        <!-- SeekBar for Playback Progress -->
        <SeekBar
            android:id="@+id/audioSeekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp" />
    </LinearLayout>

    <!-- Card view for input file content -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:visibility="gone"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:cardMaxElevation="6dp" />

    <!-- Image view -->
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginBottom="20dp"
        android:scaleType="centerCrop" />

    <!-- ScrollView for vertical scrolling -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical"
        android:fadeScrollbars="false">

        <!-- HorizontalScrollView for horizontal scrolling -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="horizontal"
            android:fadeScrollbars="false">

            <!-- Table layout for the medication list -->
            <TableLayout
                android:id="@+id/tableLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:stretchColumns="*"
                android:background="#FFFFFF"
                android:layout_gravity="center"
                android:padding="16dp"
                android:elevation="4dp"
                android:layout_marginBottom="20dp"
                android:divider="#CCCCCC"
                android:dividerPadding="1dp">

                <!-- Header row -->
                <TableRow
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <TextView
                        android:text="Name"
                        android:textStyle="bold"
                        android:textSize="28sp"
                        android:textColor="#000000"
                        android:padding="12dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:background="#DDDDDD" />

                    <TextView
                        android:text="Administration"
                        android:textStyle="bold"
                        android:textSize="28sp"
                        android:textColor="#000000"
                        android:padding="12dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:background="#DDDDDD" />

                    <TextView
                        android:text="Dosage"
                        android:textStyle="bold"
                        android:textSize="28sp"
                        android:textColor="#000000"
                        android:padding="12dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:background="#DDDDDD" />

                    <TextView
                        android:text="Frequency"
                        android:textStyle="bold"
                        android:textSize="28sp"
                        android:textColor="#000000"
                        android:padding="12dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:background="#DDDDDD" />
                </TableRow>

            </TableLayout>
        </HorizontalScrollView>
    </ScrollView>
</LinearLayout>
